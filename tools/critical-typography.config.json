        {
          "name": "H1のウェイトを下げる",
          "find": "      font-weight: 900;",
          "replace": "      font-weight: 700;"
        },
        {
          "name": "H2のウェイトを下げる",
          "find": "      font-weight: 800;",
          "replace": "      font-weight: 700;"
