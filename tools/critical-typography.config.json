          "find": "animation: bar-cta-drop .64s cubic-bezier(.22, 1, .36, 1) 1s backwards;",
          "replace": "animation: none;"
        },
        {
          "name": "申込導線のカーソルを削除",
          "find": "class=\"cta-cursor\"",
          "replace": "class=\"cta-cursor-removed\""
        },
        {
          "name": "申込導線のカーソルを「なぜ0円なのか」より前から表示する",
          "find": "var revealProgress = Math.max(0, Math.min(1, (window.scrollY - revealStartY) / Math.max(1, entryY - revealStartY)));",
