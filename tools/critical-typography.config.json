{
  "pages": [
    {
      "path": "Interviews/saas-team/index.html",
      "requiredGoogleFonts": [
        "Inter",
        "Noto Sans JP",
        "Noto Serif JP"
      ],
      "requiredFallbackFonts": [
        "Hiragino Kaku Gothic ProN",
        "Yu Gothic",
        "Yu Mincho",
        "sans-serif",
        "serif"
      ],
      "selfTestMutations": [
        {
          "name": "interview Google Fonts stylesheet removed",
          "find": "<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@600;700;800;900&amp;family=Noto+Sans+JP:wght@400;500;600;700;800;900&amp;family=Noto+Serif+JP:wght@600;700;900&amp;display=swap\" rel=\"stylesheet\">",
          "replace": ""
        },
        {
          "name": "interview Noto Serif JP removed from request",
          "find": "family=Noto+Serif+JP:wght@600;700;900",
          "replace": "family=Noto+Sans+JP:wght@600;700;900"
        }
      ]
    },
    {
      "path": "worklog-insight/index.html",
      "requiredGoogleFonts": [
        "Inter",
        "Noto Sans JP"
      ],
      "requiredFallbackFonts": [
        "sans-serif"
      ],
      "selfTestMutations": [
        {
          "name": "Google Fonts stylesheet removed",
          "find": "<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&amp;family=Noto+Sans+JP:wght@400;500;600;700;800;900&amp;display=swap\" rel=\"stylesheet\">",
          "replace": ""
        },
        {
          "name": "Noto Sans JP removed from request",
          "find": "family=Noto+Sans+JP:wght@400;500;600;700;800;900",
          "replace": "family=Roboto:wght@400;500;600;700;800;900"
        }
      ]
    },
    {
      "path": "ai-business-partner/index.html",
      "forbidRemoteFonts": true,
      "requiredFallbackFonts": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Hiragino Sans",
        "Yu Gothic",
        "Meiryo"
      ],
      "requiredRules": [
        {
          "selector": "h1,h2,h3,h4",
          "declarations": {
            "font-weight": "900",
            "-webkit-text-stroke": ".35px currentColor"
          }
        },
        {
          "selector": ".hero h1",
          "declarations": {
            "font-weight": "900",
            "-webkit-text-stroke": ".7px currentColor"
          }
        },
        {
          "selector": ".body p.lead",
          "declarations": {
            "font-size": "clamp(20px,2.2vw,24px)",
            "font-weight": "900",
            "-webkit-text-stroke": ".4px currentColor"
          },
          "after": [
            ".body p",
            ".body p:last-child"
          ]
        }
      ],
      "forbiddenRules": [
        ".lead"
      ],
      "requiredOccurrences": [
        {
          "text": "class=\"lead\"",
          "minimum": 3
        }
      ],
      "selfTestMutations": [
        {
          "name": "hero weight compensation removed",
          "find": "-webkit-text-stroke:.7px currentColor",
          "replace": "-webkit-text-stroke:0 currentColor"
        },
        {
          "name": "lead selector loses specificity",
          "find": ".body p.lead{font-size:clamp(20px,2.2vw,24px)",
          "replace": ".lead{font-size:clamp(20px,2.2vw,24px)"
        },
        {
          "name": "lead text shrinks to body size",
          "find": "font-size:clamp(20px,2.2vw,24px);font-weight:900;line-height:1.8",
          "replace": "font-size:16px;font-weight:900;line-height:1.8"
        }
      ]
    },
    {
      "path": "monitor/elliot/index.html",
      "requiredGoogleFonts": [
        "Noto Sans JP",
        "Zen Old Mincho"
      ],
      "requiredFallbackFonts": [
        "Hiragino Sans",
        "Yu Gothic",
        "Meiryo",
        "sans-serif",
        "Hiragino Mincho ProN",
        "Yu Mincho",
        "serif"
      ],
      "selfTestMutations": [
        {
          "name": "Google Fontsのstylesheetを削除",
          "find": "<link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&amp;family=Zen+Old+Mincho:wght@400;700;900&amp;display=swap\" rel=\"stylesheet\">",
          "replace": ""
        },
        {
          "name": "見出し用のZen Old Minchoを取得対象から外す",
          "find": "family=Zen+Old+Mincho:wght@400;700;900",
          "replace": "family=Roboto+Serif:wght@400;700;900"
        },
        {
          "name": "代替フォント指定を失う",
          "find": "--serif: \"Zen Old Mincho\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif;",
          "replace": "--serif: \"Zen Old Mincho\";"
        }
      ]
    }
  ]
}
